{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/desporto24",
  "git": {
    "deploymentEnabled": {
      "feat/**": false,
      "fix/**": false,
      "perf/**": false,
      "chore/**": false,
      "docs/**": false,
      "test/**": false,
      "refactor/**": false,
      "ci/**": false
    }
  },
  "rewrites": [
    {
      "source": "/sessions/:id(\\d+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|facebot|meta-externalagent|whatsapp|twitterbot|linkedinbot|slackbot|telegrambot|discordbot|skypeuripreview|pinterest|embedly).*"
        }
      ],
      "destination": "https://api.jynlosports.com/api/share/sessions/:id"
    },
    {
      "source": "/menu/communities/:id(\\d+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|facebot|meta-externalagent|whatsapp|twitterbot|linkedinbot|slackbot|telegrambot|discordbot|skypeuripreview|pinterest|embedly).*"
        }
      ],
      "destination": "https://api.jynlosports.com/api/share/communities/:id"
    },
    {
      "source": "/menu/perfis/:username([A-Za-z0-9._-]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|facebot|meta-externalagent|whatsapp|twitterbot|linkedinbot|slackbot|telegrambot|discordbot|skypeuripreview|pinterest|embedly).*"
        }
      ],
      "destination": "https://api.jynlosports.com/api/share/profiles/:username"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
