# Chat and social link-preview crawlers do not run JavaScript, so they cannot read
# the share tags the single-page app sets after it loads. They are sent a small
# HTML page from the backend instead. Search-engine crawlers are deliberately not
# listed: they should see the same app as everyone else.
map $http_user_agent $link_preview_bot {
    default 0;
    "~*(facebookexternalhit|facebot|meta-externalagent|whatsapp|twitterbot|linkedinbot|slackbot|telegrambot|discordbot|skypeuripreview|pinterest|embedly)" 1;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Render terminates TLS before nginx; these headers reach public HTTPS.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Compatibility-safe CSP for Google login, images and maps.
    add_header Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /media/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # A shared game link: link-preview crawlers get the backend's share page
    # (re-entering the /api/ proxy above), everyone else gets the app.
    location ~ ^/sessions/[0-9]+/?$ {
        if ($link_preview_bot) {
            rewrite ^/sessions/([0-9]+)/?$ /api/share/sessions/$1 last;
        }
        try_files /index.html =404;
    }

    # Shared community and profile links get their own preview card, in the same way.
    location ~ ^/menu/communities/[0-9]+/?$ {
        if ($link_preview_bot) {
            rewrite ^/menu/communities/([0-9]+)/?$ /api/share/communities/$1 last;
        }
        try_files /index.html =404;
    }

    location ~ ^/menu/perfis/[A-Za-z0-9._-]+/?$ {
        if ($link_preview_bot) {
            rewrite ^/menu/perfis/([A-Za-z0-9._-]+)/?$ /api/share/profiles/$1 last;
        }
        try_files /index.html =404;
    }

    # Serve fresh HTML after security releases, while assets remain cacheable.
    location = /index.html {
        expires -1;
    }

    # Never serve hidden config or key files.
    location ~ /\.(?!well-known) {
        return 404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
